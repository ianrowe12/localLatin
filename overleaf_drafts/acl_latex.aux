\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces AUCROC across normalized layer depth for the six models. LaTa and PhilTa show the clearest mid-layer dip before post-processing. ABTT flattens those curves much more than SIF or whitening.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:dip}{{2}{9}{AUCROC across normalized layer depth for the six models. LaTa and PhilTa show the clearest mid-layer dip before post-processing. ABTT flattens those curves much more than SIF or whitening}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cosine gap across normalized layer depth for the six models. In the Latin T5 models, the baseline gap nearly vanishes in the middle layers. ABTT restores a positive gap across depth more reliably than the alternative baselines.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:gap}{{3}{10}{Cosine gap across normalized layer depth for the six models. In the Latin T5 models, the baseline gap nearly vanishes in the middle layers. ABTT restores a positive gap across depth more reliably than the alternative baselines}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces t-SNE projections of the 1{,}705 labelled fragments at each model's best layer (rows: LaTa, PhilTa, mT5-base), for mean-pooled \texttt  {baseline} and pure \texttt  {ABTT} ($D{=}10$) columns. Colors mark the six most-populated directories (\texttt  {CNEO.315.13}, \texttt  {CNIC.325.16}, \texttt  {CANC.314.4}, \texttt  {CANC.314.20}, \texttt  {CNIC.325.6}, \texttt  {CNIC.325.4}; sizes 8--10); all other fragments are suppressed. ABTT produces visibly tighter same-color clusters than the baseline, with winnable-fragment silhouette scores rising by 0.09--0.75 on every model.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:tsne}{{4}{11}{t-SNE projections of the 1{,}705 labelled fragments at each model's best layer (rows: LaTa, PhilTa, mT5-base), for mean-pooled \texttt {baseline} and pure \texttt {ABTT} ($D{=}10$) columns. Colors mark the six most-populated directories (\texttt {CNEO.315.13}, \texttt {CNIC.325.16}, \texttt {CANC.314.4}, \texttt {CANC.314.20}, \texttt {CNIC.325.6}, \texttt {CNIC.325.4}; sizes 8--10); all other fragments are suppressed. ABTT produces visibly tighter same-color clusters than the baseline, with winnable-fragment silhouette scores rising by 0.09--0.75 on every model}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces UMAP projections, same configuration as Figure~\ref {fig:tsne}. The per-method separation pattern is reproduced under a different dimensionality-reduction algorithm, supporting that the cluster-tightening is a property of the embedding geometry rather than of the projection method.}}{12}{figure.caption.10}\protected@file@percent }
\newlabel{fig:umap}{{5}{12}{UMAP projections, same configuration as Figure~\ref {fig:tsne}. The per-method separation pattern is reproduced under a different dimensionality-reduction algorithm, supporting that the cluster-tightening is a property of the embedding geometry rather than of the projection method}{figure.caption.10}{}}
