[Unit]
Description=LocalLatin Scholar Review - FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/homes/ipro222/localLatin
Environment=LOCALLATIN_CONFIG=/homes/ipro222/localLatin/web/config.production.yaml
Environment=LOCALLATIN_DATA_ROOT=/homes/ipro222/localLatin
Environment=PATH=/homes/ipro222/localLatin/.venv/bin:/usr/bin:/bin
ExecStart=/homes/ipro222/localLatin/.venv/bin/uvicorn web.app:create_app --factory --host 127.0.0.1 --port 8080 --workers 1 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=locallatin

[Install]
WantedBy=default.target
